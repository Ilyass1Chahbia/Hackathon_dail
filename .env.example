# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables (or leave them empty for local demo mode).

# --- Supplied records (read-only) --------------------------------------------
# Optional override; by default the app resolves <repo>/source/initial.json.
# OCTOPUS_INITIAL_JSON=/absolute/path/to/source/initial.json

# --- Hosted Supabase (optional, server-only) ---------------------------------
# The persistence client runs in route handlers only, so it needs the secret key.
# Never use an anon, publishable or NEXT_PUBLIC key here — those are browser keys.
# Leave empty to run in "Persistence unavailable — local demo mode".
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy fallback. Prefer SUPABASE_SECRET_KEY; this name is kept only for older
# deployments whose secret key is still stored under the service-role name.
# SUPABASE_SERVICE_ROLE_KEY=
